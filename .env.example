OPTICARGO_ENVIRONMENT=development
OPTICARGO_RELEASE=dev
OPTICARGO_GIT_SHA=local
OPTICARGO_SHARED_VERSION=1.0.0
TZ=UTC

DATABASE_URL=postgresql+psycopg://opticargo:dev-only-change-me@postgres:5432/opticargo
REDIS_URL=redis://:dev-only-redis@redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dev-only-neo4j
NEO4J_DATABASE=neo4j

EVENT_STREAM=opticargo:events
EVENT_DLQ_STREAM=opticargo:events:dlq
GRAPH_CONSUMER_GROUP=graph-sync
GRAPH_CONSUMER_NAME=graph-worker-1
GRAPH_SUPPORTED_EVENT_VERSION=1.0

WORKER_CONCURRENCY=2
WORKER_BATCH_SIZE=20
WORKER_BLOCK_MS=5000
WORKER_MAX_RETRIES=5
WORKER_RETRY_BACKOFF_SECONDS=2
WORKER_PENDING_IDLE_MS=60000
WORKER_METRICS_PORT=9100
WORKER_HEALTH_FILE=/tmp/opticargo-graph-worker-health.json
WORKER_HEARTBEAT_SECONDS=10
WORKER_HEARTBEAT_STALE_SECONDS=45

GRAPH_QUERY_TIMEOUT_SECONDS=10
GRAPH_RECONCILIATION_BATCH_SIZE=500
GRAPH_RECONCILIATION_LOCK_TTL_SECONDS=3600
SCHEDULER_LOCK_KEY=opticargo:locks:graph-reconciliation
GRAPH_SCHEMA_NAME=opticargo-knowledge-graph
GRAPH_SCHEMA_TARGET_VERSION=3
GRAPH_DELETE_STALE=true
GRAPH_PROJECTION_NAMESPACE=opticargo:graph

LOG_FORMAT=json
LOG_LEVEL=INFO
CORRELATION_HEADER=X-Correlation-ID
