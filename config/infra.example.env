# -----------------------------------------------------------------------------
# OptiCargo Infra local/competition defaults
# Nilai credential pada file ini hanya dummy untuk development dan validasi CI.
# Salin menjadi .env lalu ganti seluruh nilai dev-only-* sebelum penggunaan bersama.
# File .env berisi secret lokal dan tidak boleh di-commit.

# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Platform identity
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=opticargo
OPTICARGO_ENVIRONMENT=development
OPTICARGO_RELEASE=dev
OPTICARGO_GIT_SHA=local
OPTICARGO_SHARED_VERSION=1.0.0
OPTICARGO_REGION=local
TZ=UTC


# -----------------------------------------------------------------------------
# Public and loopback ports
# -----------------------------------------------------------------------------
HTTP_PORT=8080
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
MINIO_CONSOLE_PORT=9001
NEO4J_HTTP_PORT=7474
POSTGRES_PORT=5433
GATEWAY_PORT=8000


# -----------------------------------------------------------------------------
# Registry and application images
# -----------------------------------------------------------------------------
REGISTRY=ghcr.io/opticargo-ai

FRONTEND_IMAGE=ghcr.io/opticargo-ai/opticargo-frontend:dev
GATEWAY_IMAGE=ghcr.io/opticargo-ai/opticargo-gateway-api:dev
AGENTS_IMAGE=ghcr.io/opticargo-ai/opticargo-agents:dev

# Gunakan image lokal yang dibangun dari repository opticargo-ml-models.
# Setelah image didorong ke GHCR, ganti menjadi:
# ghcr.io/opticargo-ai/opticargo-ml-models:dev
ML_MODELS_IMAGE=opticargo-ml-models:local

RAG_PIPELINE_IMAGE=ghcr.io/opticargo-ai/opticargo-rag-pipeline:dev
KNOWLEDGE_GRAPH_IMAGE=ghcr.io/opticargo-ai/opticargo-knowledge-graph:dev
DATA_IMAGE=ghcr.io/opticargo-ai/opticargo-data:dev
STREAM_EXPORTER_IMAGE=opticargo/redis-stream-exporter:dev


# -----------------------------------------------------------------------------
# Pinned supporting images
# Update only through reviewed dependency pull requests.
# -----------------------------------------------------------------------------
NGINX_IMAGE=nginx:1.27.0-alpine
POSTGRES_IMAGE=postgres:16.4-alpine
REDIS_IMAGE=redis:7.2.5-alpine
NEO4J_IMAGE=neo4j:5.21.2-community
QDRANT_IMAGE=qdrant/qdrant:v1.9.5
MINIO_IMAGE=minio/minio:RELEASE.2024-06-13T22-53-53Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-05-24T09-08-49Z
MLFLOW_IMAGE=opticargo-mlflow:2.14.1-postgres-s3
PROMETHEUS_IMAGE=prom/prometheus:v2.53.0
GRAFANA_IMAGE=grafana/grafana:11.1.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.15.0
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.62.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.25.0


# -----------------------------------------------------------------------------
# PostgreSQL application database
# -----------------------------------------------------------------------------
POSTGRES_USER=opticargo
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=opticargo
POSTGRES_STATEMENT_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# PostgreSQL MLflow database
#
# docker-compose.yml menggunakan nilai ini untuk membentuk:
# postgresql+psycopg2://mlflow:<password>@postgres:5432/mlflow
# -----------------------------------------------------------------------------
POSTGRES_MLFLOW_DB=mlflow
POSTGRES_MLFLOW_USER=mlflow
POSTGRES_MLFLOW_PASSWORD=dev-only-change-me-too


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=dev-only-redis
REDIS_MAXMEMORY=512mb
REDIS_STREAM_MAXLEN=100000
REDIS_STREAM_PENDING_ALERT=100


# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=dev-only-neo4j
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m


# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
QDRANT_API_KEY=dev-only-qdrant
QDRANT_COLLECTION=opticargo_documents_v1


# -----------------------------------------------------------------------------
# MinIO
#
# MLflow menyimpan artifact tracking pada:
# s3://opticargo-model-artifacts/mlflow
#
# ML Models menyimpan champion artifact pada:
# s3://opticargo-model-artifacts/<model>/champion/...
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=opticargo
MINIO_ROOT_PASSWORD=dev-only-minio-password

MINIO_DOCUMENTS_BUCKET=opticargo-documents
MINIO_REPORTS_BUCKET=opticargo-reports
MINIO_MODELS_BUCKET=opticargo-model-artifacts
MINIO_BACKUPS_BUCKET=opticargo-backups

MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false


# -----------------------------------------------------------------------------
# MLflow tracking
#
# Prefix menghasilkan experiment:
# opticargo-development-cargo-match
# opticargo-development-demand-forecast
# opticargo-development-operational-anomaly
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_PREFIX=opticargo-development

# Git tidak dipasang di image runtime ML; sembunyikan warning GitPython.
GIT_PYTHON_REFRESH=quiet

# true:
# - training mencatat run ke MLflow
# - champion artifact juga diunggah langsung ke MinIO object key
#
# false:
# - training tetap dapat berjalan lokal
# - direct upload champion ke MinIO dimatikan
UPLOAD_MODEL_ARTIFACT=true


# -----------------------------------------------------------------------------
# ML Models runtime behavior
# -----------------------------------------------------------------------------

# heuristic = selalu menggunakan formula fallback
# trained   = memuat trained artifact
# auto      = mencoba trained artifact dan fallback bila gagal
MODEL_MODE=auto

# Memuat ketiga model ketika service startup.
MODEL_PRELOAD=true

MODEL_LOAD_TIMEOUT_SECONDS=30
MODEL_INFERENCE_TIMEOUT_SECONDS=5

# Biarkan false selama compatibility contract masih berada di repository ML.
# Ubah menjadi true setelah kontrak opticargo-shared final sudah dipakai.
REQUIRE_SHARED_CONTRACTS=false


# -----------------------------------------------------------------------------
# Cargo Match model
# -----------------------------------------------------------------------------
CARGO_MATCH_MODEL_NAME=cargo-match-scorer
CARGO_MATCH_MODEL_VERSION=synthetic-baseline-v3-cargo-match

# Lokasi artifact di dalam container ML Models.
CARGO_MATCH_ARTIFACT_PATH=/app/artifacts/cargo_match_model.joblib

# Lokasi champion artifact di MinIO.
CARGO_MATCH_ARTIFACT_OBJECT_KEY=cargo-match/champion/cargo_match_model.joblib


# -----------------------------------------------------------------------------
# Demand Forecast model
# -----------------------------------------------------------------------------
DEMAND_FORECAST_MODEL_NAME=demand-forecaster
DEMAND_FORECAST_MODEL_VERSION=synthetic-baseline-v3-demand-forecast

DEMAND_FORECAST_ARTIFACT_PATH=/app/artifacts/demand_forecast_model.joblib
DEMAND_FORECAST_ARTIFACT_OBJECT_KEY=demand-forecast/champion/demand_forecast_model.joblib


# -----------------------------------------------------------------------------
# Operational Anomaly model
# -----------------------------------------------------------------------------
ANOMALY_MODEL_NAME=operational-anomaly-detector
ANOMALY_MODEL_VERSION=synthetic-baseline-v3-anomaly

ANOMALY_ARTIFACT_PATH=/app/artifacts/anomaly_detector.joblib
ANOMALY_ARTIFACT_OBJECT_KEY=anomaly/champion/anomaly_detector.joblib


# -----------------------------------------------------------------------------
# Model promotion guards
#
# Nilai ini menentukan apakah hasil retraining boleh dipromosikan.
# -----------------------------------------------------------------------------

# Cargo-match classifier
PROMOTION_MIN_ACCURACY=0.88
PROMOTION_MIN_F1=0.80

# Demand forecasting
PROMOTION_MIN_FORECAST_R2=0.90
PROMOTION_MAX_FORECAST_WAPE=0.20

# Operational anomaly detector
PROMOTION_MIN_ANOMALY_ROC_AUC=0.90
PROMOTION_MIN_ANOMALY_F1=0.80


# -----------------------------------------------------------------------------
# Model drift
# -----------------------------------------------------------------------------
DRIFT_PSI_ALERT_THRESHOLD=0.20


# -----------------------------------------------------------------------------
# Application secrets and internal authentication
# -----------------------------------------------------------------------------
JWT_SECRET=dev-only-jwt-secret-at-least-32-chars
INTERNAL_SERVICE_TOKEN=dev-only-internal-token

LLM_API_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

WHATSAPP_PROVIDER_TOKEN=


# -----------------------------------------------------------------------------
# Public and internal application configuration
# -----------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8080

GATEWAY_INTERNAL_URL=http://gateway-api:8000
AGENTS_INTERNAL_URL=http://agents:8000
ML_MODELS_INTERNAL_URL=http://ml-models:8000

DATABASE_URL=postgresql+psycopg://opticargo:dev-only-change-me@postgres:5432/opticargo

REDIS_URL=redis://:dev-only-redis@redis:6379/0
CELERY_BROKER_URL=redis://:dev-only-redis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:dev-only-redis@redis:6379/2

NEO4J_URI=bolt://neo4j:7687
QDRANT_URL=http://qdrant:6333


# -----------------------------------------------------------------------------
# Consumer groups and queue contracts
# -----------------------------------------------------------------------------
EVENT_STREAM=opticargo:events
EVENT_DLQ_STREAM=opticargo:events:dlq
OUTBOX_PUBLISHER_STREAM=opticargo:outbox:publisher

GRAPH_CONSUMER_GROUP=graph-sync
RAG_CONSUMER_GROUP=rag-ingestion
NOTIFICATION_CONSUMER_GROUP=notifications
ANALYTICS_CONSUMER_GROUP=analytics

CELERY_NOTIFICATIONS_QUEUE=notifications
CELERY_REPORTS_QUEUE=reports
CELERY_MAINTENANCE_QUEUE=maintenance


# -----------------------------------------------------------------------------
# Configurable startup contracts
# Align these values with the corresponding application repositories.
# -----------------------------------------------------------------------------
GATEWAY_COMMAND=uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers
GATEWAY_MIGRATION_COMMAND=alembic upgrade head
OUTBOX_PUBLISHER_COMMAND=python -m app.workers.outbox_publisher

NOTIFICATION_WORKER_COMMAND=celery -A app.celery_app worker -Q notifications --concurrency=2 --loglevel=INFO
REPORT_WORKER_COMMAND=celery -A app.celery_app worker -Q reports --concurrency=1 --loglevel=INFO

AGENTS_COMMAND=uvicorn opticargo_agents.api:app --host 0.0.0.0 --port 8000 --proxy-headers

ML_MODELS_COMMAND=uvicorn opticargo_ml_models.api:app --host 0.0.0.0 --port 8000 --proxy-headers

RAG_WORKER_COMMAND=python -m opticargo_rag_pipeline.worker

GRAPH_WORKER_COMMAND=python -m opticargo_knowledge_graph.worker
GRAPH_RECONCILIATION_COMMAND=python -m opticargo_knowledge_graph.reconcile

# ML scheduled and one-off jobs
ML_RETRAINING_COMMAND=python -m opticargo_ml_models.jobs.retrain --model all --data-dir /app/data/synthetic --artifact-dir /app/artifacts --release synthetic-baseline-v4 --lock /tmp/opticargo-retraining.lock
ML_DRIFT_COMMAND=python -m opticargo_ml_models.jobs.drift

DATA_SEED_COMMAND=python -m opticargo_data.seed --profile competition --idempotent
DATA_RESET_COMMAND=python -m opticargo_data.reset --profile competition --approved-only


# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_TO_MINIO=false
BACKUP_ENCRYPTION_RECIPIENT=

RUN_PREDEPLOY_BACKUP=true

SMOKE_BASE_URL=http://localhost:8080
SMOKE_TIMEOUT_SECONDS=10
HEALTH_WAIT_SECONDS=180

LOG_MAX_SIZE=10m
LOG_MAX_FILES=5


# -----------------------------------------------------------------------------
# Grafana and alerting
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev-only-grafana

ALERT_RECEIVER_WEBHOOK=

RUNBOOK_BASE_URL=https://github.com/opticargo-ai/opticargo-infra/blob/main/runbooks
