name: Knowledge Graph Release

on:
  workflow_dispatch:
    inputs:
      version:
        description: SemVer release without a leading v
        required: true
        type: string
      shared_ref:
        description: Immutable opticargo-shared commit or release tag
        required: true
        default: 62adca4
        type: string

permissions:
  contents: read
  packages: write
  id-token: write
  attestations: write

jobs:
  build-and-verify:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    environment: production-release
    steps:
      - uses: actions/checkout@v4
        with:
          path: opticargo-knowledge-graph
      - uses: actions/checkout@v4
        with:
          repository: Project-OptiCargo-Tol-Laut/opticargo-shared
          ref: ${{ inputs.shared_ref }}
          path: opticargo-shared
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
      - name: Validate version input
        env:
          RELEASE_VERSION: ${{ inputs.version }}
        run: |
          python -c "import os,re; value=os.environ['RELEASE_VERSION']; assert re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?', value), value"
      - name: Install and run release gates
        run: |
          python -m pip install --upgrade pip build ruff
          python -m pip install ./opticargo-shared
          python -m pip install -e './opticargo-knowledge-graph[dev]'
          cd opticargo-knowledge-graph
          ruff check src tests scripts
          pytest -q
          python scripts/smoke_structure.py
          python -m build
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - uses: docker/setup-buildx-action@v3
      - name: Build immutable container image
        id: build
        uses: docker/build-push-action@v6
        with:
          context: .
          file: opticargo-knowledge-graph/Dockerfile
          push: true
          provenance: true
          sbom: true
          tags: |
            ghcr.io/${{ github.repository_owner }}/opticargo-knowledge-graph:${{ inputs.version }}
            ghcr.io/${{ github.repository_owner }}/opticargo-knowledge-graph:sha-${{ github.sha }}
      - name: Generate SBOM
        uses: anchore/sbom-action@v0
        with:
          image: ghcr.io/${{ github.repository_owner }}/opticargo-knowledge-graph:${{ inputs.version }}
          artifact-name: opticargo-knowledge-graph-${{ inputs.version }}.spdx.json
          output-file: opticargo-knowledge-graph-${{ inputs.version }}.spdx.json
      - name: Scan released image
        uses: aquasecurity/trivy-action@0.28.0
        with:
          image-ref: ghcr.io/${{ github.repository_owner }}/opticargo-knowledge-graph:${{ inputs.version }}
          format: table
          exit-code: "1"
          severity: CRITICAL,HIGH
      - name: Attest image provenance
        uses: actions/attest-build-provenance@v2
        with:
          subject-name: ghcr.io/${{ github.repository_owner }}/opticargo-knowledge-graph
          subject-digest: ${{ steps.build.outputs.digest }}
          push-to-registry: true
      - uses: actions/upload-artifact@v4
        with:
          name: knowledge-graph-release-${{ inputs.version }}
          path: |
            opticargo-knowledge-graph/dist/*
            opticargo-knowledge-graph-${{ inputs.version }}.spdx.json
          if-no-files-found: error
